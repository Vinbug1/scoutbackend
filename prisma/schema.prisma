datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  PLAYER
  SCOUT
  ADMIN
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ParticipantStatus {
  ACTIVE
  COMPLETED
  DROPPED
  PAUSED
}

enum Recommendation {
  RECOMMEND_FOR_TRIAL
  FILE_FOR_FUTURE_REFERENCE
  NOT_SUITABLE
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum ChatRoomType {
  DIRECT
  GROUP
}

// NEW — group membership management (spec §4.5) needs to distinguish
// admins (can add/remove/promote members) from ordinary members. The
// original schema had no role field at all, so every membership
// endpoint in §4.5 (add member / remove member / change role) had
// nothing to authorize against.
enum ChatMemberRole {
  MEMBER
  ADMIN
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  fullname  String
  role      Role     @default(PLAYER)
  createdAt DateTime @default(now())

  // OTP Verification
  otp        String?
  otpExpiry  DateTime?
  isVerified Boolean   @default(false)

  // Relations
  profile           Profile?
  scoutProfile      ScoutProfile?
  videos            Video[]
  reels             Reel[]
  views             VideoView[]
  reelViews         ReelView[]
  comments          Comment[]
  replies           Reply[]
  ratings           Rating[]
  followers         Follower[]             @relation("Followed")
  following         Follower[]             @relation("Following")
  posts             Post[]

  // ✅ Like relations
  commentLikes      CommentLike[]
  reelLikes         ReelLike[]
  replyLikes        ReplyLike[]

  // Scout reports
  reportsFiled      ScouterReport[]        @relation("ReportsByScouter")
  reportsAboutMe    ScouterReport[]        @relation("ReportsAboutPlayer")
  createdChatRooms ChatRoom[]            @relation("ChatRoomCreator")
  payments          Payment[]
  rankings          Ranking[]
  chatMessages      ChatMessage[]
  chatRoomMembers   ChatRoomMember[]
  challengesCreated Challenge[]            @relation("ChallengeCreator")
  challengesJoined  ChallengeParticipant[]

  pushToken   String?
  isOnline    Boolean   @default(false)
  lastSeenAt  DateTime?
  blocksMade  Block[]   @relation("BlockedBy")
  blocksTaken Block[]   @relation("BlockedUser")
  reportsMade Report[]  @relation("ReportedBy")
  messageReads             MessageRead[]
  reportsAgainstMe         Report[]                 @relation("ReportedUser")

  // NEW — needed by the two new tables added below (spec §6.2's "delete
  // for me" and §11/§12's delivery receipts). Without these back-relations
  // the new models can't have a `user User @relation(...)` field.
  messageDeliveryReceipts  MessageDeliveryReceipt[]
  messageDeletions         MessageDeletionForUser[]
}

// ─────────────────────────────────────────────
// Profiles
// ─────────────────────────────────────────────

model Profile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  avatarUrl     String?
  position      String?
  height        Float?
  favouriteFoot String?
  strengths     String?
  gender        String?
  country       String?
  city          String?
  dob           DateTime?
  bio           String?
  createdAt     DateTime  @default(now())
}

model ScoutProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  avatarUrl String?
  club      String?
  country   String?
  city      String?
  address   String?
  bio       String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// Scouter Report
// ─────────────────────────────────────────────

model ScouterReport {
  id        Int      @id @default(autoincrement())
  scouterId Int
  playerId  Int
  createdAt DateTime @default(now())

  // 1. Match Info
  matchScouted String?
  ageGroup     String?
  timesSeen    Int?
  currentClub  String?

  // 2. Overall Assessment
  overallAssessment String?

  // 3A. Technical Attributes (1–10)
  firstTouch   Int?
  ballControl  Int?
  dribbling    Int?
  passingShort Int?
  passingLong  Int?
  throughBalls Int?
  smartPass    Int?
  shooting     Int?
  heading      Int?
  tackling     Int?
  weakerFoot   Int?

  // 3B. Tactical Attributes (1–10)
  positionalAwareness Int?
  decisionMaking      Int?
  movementOffBall     Int?
  gameIntelligence    Int?
  transitions         Int?

  // 3C. Physical Attributes (1–10)
  pace            Int?
  agilityBalance  Int?
  strength        Int?
  staminaWorkRate Int?
  jumpingRate     Int?

  // 3D. Psychological Attributes (1–10)
  composure               Int?
  braveryCommitment       Int?
  determination           Int?
  leadershipCommunication Int?
  coachability            Int?

  // 4 & 5. Summaries
  keyStrengths        String[]
  areasForDevelopment String[]

  // 6. Final Recommendation
  recommendation Recommendation?

  scouter User @relation("ReportsByScouter", fields: [scouterId], references: [id])
  player  User @relation("ReportsAboutPlayer", fields: [playerId], references: [id])

  @@index([playerId])
  @@index([scouterId])
}

// ─────────────────────────────────────────────
// Video & Reel
// ─────────────────────────────────────────────

model VideoCategory {
  id    Int    @id @default(autoincrement())
  title String
  reels Reel[]
}

model Video {
  id           Int      @id @default(autoincrement())
  videoUrl     String
  thumbnailUrl String?
  title        String
  description  String?
  published    Boolean  @default(false)
  durationSec  Int?
  createdAt    DateTime @default(now())
  status       String   @default("processing")

  playerId Int
  player   User @relation(fields: [playerId], references: [id])

  views    VideoView[]
  comments Comment[]
  ratings  Rating[]

  @@index([playerId])
  @@index([createdAt])
}

model Reel {
  id           Int      @id @default(autoincrement())
  videoUrl     String
  thumbnailUrl String?
  title        String
  description  String?
  published    Boolean  @default(false)
  durationSec  Int?
  createdAt    DateTime @default(now())
  status       String   @default("processing")

  categoryId Int
  category   VideoCategory @relation(fields: [categoryId], references: [id])

  playerId Int
  player   User @relation(fields: [playerId], references: [id])

  views    ReelView[]
  comments Comment[]
  ratings  Rating[]

  // ✅ Added
  likes    ReelLike[]

  @@index([playerId])
  @@index([createdAt])
  @@index([categoryId])
}

// ─────────────────────────────────────────────
// Views
// ─────────────────────────────────────────────

model VideoView {
  id       Int      @id @default(autoincrement())
  videoId  Int
  userId   Int?
  ipHash   String?
  viewedAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  @@unique([videoId, userId], name: "unique_view_per_user")
  @@index([videoId])
  @@index([userId])
}

model ReelView {
  id       Int      @id @default(autoincrement())
  reelId   Int
  userId   Int?
  ipHash   String?
  viewedAt DateTime @default(now())

  reel Reel  @relation(fields: [reelId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([reelId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Comments, Replies & Likes
// ─────────────────────────────────────────────

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())

  videoId Int?
  postId  Int?
  reelId  Int?
  userId  Int

  video   Video?  @relation(fields: [videoId], references: [id])
  post    Post?   @relation(fields: [postId], references: [id])
  reel    Reel?   @relation(fields: [reelId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  replies Reply[]

  // ✅ Added
  likes   CommentLike[]

  @@index([videoId])
  @@index([postId])
  @@index([reelId])
}

model CommentLike {
  id        Int @id @default(autoincrement())
  commentId Int
  userId    Int

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model Reply {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())

  commentId Int
  userId    Int

  comment Comment    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id])

  // ✅ Added
  likes   ReplyLike[]

  @@index([commentId])
  @@index([userId])
}

model ReplyLike {
  id      Int @id @default(autoincrement())
  replyId Int
  userId  Int

  reply Reply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([replyId])
  @@index([userId])
}

model ReelLike {
  id     Int @id @default(autoincrement())
  reelId Int
  userId Int

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reelId, userId])
  @@index([reelId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Ratings & Rankings
// ─────────────────────────────────────────────

model Rating {
  id        Int      @id @default(autoincrement())
  score     Int
  createdAt DateTime @default(now())

  videoId Int?
  reelId  Int?
  userId  Int

  video Video? @relation(fields: [videoId], references: [id])
  reel  Reel?  @relation(fields: [reelId], references: [id])
  user  User   @relation(fields: [userId], references: [id])

  @@unique([videoId, userId])
  @@unique([reelId, userId])
  @@index([videoId])
  @@index([reelId])
}

model Ranking {
  id        Int      @id @default(autoincrement())
  userId    Int
  score     Float    @default(0)
  reason    String?
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId])
  @@index([score])
}

// ─────────────────────────────────────────────
// Posts
// ─────────────────────────────────────────────

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  userId    Int

  user     User      @relation(fields: [userId], references: [id])
  comments Comment[]
}

// ─────────────────────────────────────────────
// Followers
// ─────────────────────────────────────────────

model Follower {
  id         Int      @id @default(autoincrement())
  followerId Int
  followedId Int
  followedAt DateTime @default(now())

  follower User @relation("Following", fields: [followerId], references: [id])
  followed User @relation("Followed", fields: [followedId], references: [id])

  @@unique([followerId, followedId])
  @@index([followedId])
  @@index([followerId])
}

// ─────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────

model Payment {
  id          Int           @id @default(autoincrement())
  userId      Int
  amount      Float
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Challenges
// ─────────────────────────────────────────────

model Challenge {
  id             Int       @id @default(autoincrement())
  videoUrl       String
  thumbnailUrl   String?
  title          String
  description    String?
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime  @default(now())
  targetProgress Float     @default(100)

  creatorId Int
  creator   User @relation("ChallengeCreator", fields: [creatorId], references: [id])

  participants ChallengeParticipant[]
}

model ChallengeParticipant {
  id          Int               @id @default(autoincrement())
  challengeId Int
  userId      Int
  joinedAt    DateTime          @default(now())
  completedAt DateTime?
  progress    Float             @default(0)
  status      ParticipantStatus @default(ACTIVE)

  challenge Challenge @relation(fields: [challengeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  progressLogs ProgressLog[]

  @@unique([challengeId, userId])
  @@index([status])
  @@index([progress])
}

model ProgressLog {
  id            Int      @id @default(autoincrement())
  participantId Int
  taskId        Int?
  description   String
  progressDelta Float
  createdAt     DateTime @default(now())

  participant ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Chat
//
// Fixed against the technical spec. Key differences from the previous
// version of this section are called out inline as comments; a full
// summary is in the chat response, not repeated here.
// ─────────────────────────────────────────────

model ChatRoom {
  id   Int          @id @default(autoincrement())
  type ChatRoomType @default(DIRECT)
  name String?

  creatorId Int?
  creator   User? @relation("ChatRoomCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW — monotonic per-room counter. Every ChatMessage.seq is assigned
  // from this inside the SAME transaction as the message insert (spec
  // §5.2). This is what makes pagination (§10.1) and unread counts
  // (§7.2: seqCounter - lastReadSeq, computed not stored) correct.
  // sentAt/updatedAt alone can't serve as a cursor: concurrent sends can
  // land in the same millisecond or arrive out of order.
  seqCounter Int @default(0)

  directKey String? @unique // dedup key for DIRECT rooms: [userIdA, userIdB].sort().join(':')

  messages ChatMessage[]    @relation("RoomMessages")
  members  ChatRoomMember[]

  // CHANGED — was a direct `lastMessageId Int? @unique` FK straight to
  // ChatMessage. Replaced with a dedicated cache table (spec §7.1/§7.3)
  // so the inbox list query never has to join ChatMessage (and its
  // profile/media fields) just to render a preview string, and so
  // `updatedAt` on the cache row can be indexed independently as the
  // inbox pagination cursor.
  lastMessage ChatLastMessage?

  @@index([type])
  @@index([updatedAt])
}

model ChatRoomMember {
  id Int @id @default(autoincrement())

  roomId Int
  userId Int

  joinedAt DateTime @default(now())

  // NEW — group membership management (spec §4.5) requires knowing who's
  // an admin. Previously nothing on this model distinguished members
  // from admins, so add/remove/promote endpoints had nothing to check.
  role ChatMemberRole @default(MEMBER)

  // CHANGED — replaces `unreadCount Int @default(0)` and
  // `lastReadMessageId Int?`. Per spec §7.2, unread count must be
  // *computed* as `room.seqCounter - lastReadSeq`, never stored as its
  // own counter: a stored counter can drift out of sync under retries,
  // multi-device races, or partial failures, and there's no way to
  // detect that it's wrong. lastReadSeq/lastDeliveredSeq also let
  // message:read use the conditional-update guard from spec §5.2/14.27
  // (`lastReadSeq: { lt: upToSeq }`) to stop a stale/out-of-order read
  // event from moving read state backward — that guard doesn't work
  // against a message-id pointer the way it works against a seq number.
  lastReadSeq      Int @default(0)
  lastDeliveredSeq Int @default(0)

  // NEW — needed to enforce mute in the push-notification worker
  // (spec §12: `if (mutedUntil && new Date(mutedUntil) > new Date()) continue;`).
  // The old schema had no way to mute a room per-member at all.
  mutedUntil DateTime?

  isBlockedByPeer Boolean @default(false)

  room ChatRoom @relation(fields: [roomId], references: [id])
  user User     @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model ChatMessage {
  id Int @id @default(autoincrement())

  roomId Int
  userId Int

  // NEW — the ordering/pagination/read-cursor key described above.
  // Assigned as room.seqCounter incremented inside the create
  // transaction (spec §5.2), never client-supplied.
  seq Int

  clientTempId String?

  type MessageType @default(TEXT)

  text String?

  mediaUrl     String?
  thumbnailUrl String?
  blurhash      String?


  // NEW — spec §8.2 needs somewhere to record transcode/processing state
  // (e.g. { processingStatus: "processing" | "ready" | "failed" }) so the
  // transcode worker and its failure handler have a field to write to.
  mediaMeta Json?

  fileName    String?
  fileSize    Int?
  durationSec Int?

  status MessageStatus @default(SENT)

  sentAt    DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  room       ChatRoom         @relation("RoomMessages", fields: [roomId], references: [id])
  user       User             @relation(fields: [userId], references: [id])
  roomAsLast ChatLastMessage?

  replyToId Int?
  // NOTE (spec §14.26 / §5.2): this FK is a data-integrity nicety only —
  // it does NOT guarantee replyToId belongs to the same room. A message
  // in room A can still have an id that's technically reachable as
  // replyToId from room B. The application layer MUST verify
  // `original.roomId === this.roomId` before trusting the reference and
  // before snapshotting replyToPreview/replyToSenderId — otherwise this
  // is a cross-room content leak the moment replyToPreview gets broadcast
  // to room B's participants. A bad/mismatched replyToId should be
  // silently dropped (send as a normal message), not fail the whole send.
  replyTo         ChatMessage?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         ChatMessage[] @relation("MessageReply")

  // NEW — snapshotted at write time (after the same-room check above),
  // so rendering a reply preview never requires re-fetching or re-joining
  // the original message (which may since have been edited or deleted).
  replyToPreview  String?
  replyToSenderId Int?

  reads             MessageRead[]
  // NEW — spec §12 push-notification/delivery flow: a delivery ack is a
  // distinct event from a read receipt (you can deliver to a device that
  // hasn't opened the chat yet). The old schema only had MessageRead,
  // with nothing recording "device received this" separately.
  deliveryReceipts  MessageDeliveryReceipt[]
  // NEW — spec §6.2 "delete for me": removing a message from just your
  // own view without affecting other participants. The old schema only
  // supported a single global `deletedAt` (delete for everyone) — there
  // was no way to represent "hidden for user X only."
  deletedFor        MessageDeletionForUser[]
  reports           Report[]

  // NEW — the pagination/ordering guarantee itself (spec §3 "Required
  // indexes" table): keyset cursor and strict per-room ordering.
  @@unique([roomId, seq])
  // CHANGED — was a bare `clientTempId String? @unique` (global
  // uniqueness across every room and every user). Scoping it to
  // (roomId, userId, clientTempId) matches spec §3/§4.3: idempotent
  // send-retry keys only need to be unique per sender per conversation,
  // and global uniqueness is an unnecessary constraint that could reject
  // a legitimate retry key reused (deliberately or by a buggy client)
  // across unrelated rooms.
  @@unique([roomId, userId, clientTempId])
  @@index([roomId, sentAt])
  // NEW — spec §11.2 "edits/deletes since last seen" reconnect query
  // (`updatedAt: { gt: since } `) needs this to not be a full table scan.
  @@index([roomId, updatedAt])
  @@index([roomId, status])
  @@index([replyToId])
  @@index([status])
  @@index([userId])
}

// NEW MODEL — replaces the old direct `ChatRoom.lastMessageId` FK.
// Decouples the inbox-list cache (cheap to read, indexed by updatedAt
// for pagination per spec §7.3) from the live Message row, and lets
// preview text be corrected in place on edit/delete (spec §7.5:
// maybeUpdateInboxPreviewOnEdit/OnDelete) via a plain conditional
// updateMany instead of re-resolving a nullable FK.
model ChatLastMessage {
  roomId Int      @id
  room   ChatRoom @relation(fields: [roomId], references: [id])

  messageId Int         @unique
  message   ChatMessage @relation(fields: [messageId], references: [id])

  senderId  Int?
  seq       Int      @default(0)
  preview   String?
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model MessageRead {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  readAt    DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// NEW MODEL — spec §3/§12: per-user, per-message delivery acknowledgement,
// distinct from a read receipt. Backs the `message:delivered` handler
// (spec §5.2) and lets computeStatus (spec §10.1) distinguish "delivered
// but not read" from "read."
model MessageDeliveryReceipt {
  id          Int      @id @default(autoincrement())
  messageId   Int
  userId      Int
  deliveredAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// NEW MODEL — spec §6.2 "delete for me": a message hidden for one
// participant without being deleted for everyone else. getMessagePage
// (spec §10.1) filters on `deletedFor: { none: { userId } }`.
model MessageDeletionForUser {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  deletedAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("BlockedBy", fields: [blockerId], references: [id])
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model Report {
  id         Int      @id @default(autoincrement())
  reporterId Int
  reportedId Int
  messageId  Int?
  reason     String
  createdAt  DateTime @default(now())

  reporter User         @relation("ReportedBy", fields: [reporterId], references: [id])
  reported User         @relation("ReportedUser", fields: [reportedId], references: [id])
  message  ChatMessage? @relation(fields: [messageId], references: [id])

  @@index([reportedId])
}
